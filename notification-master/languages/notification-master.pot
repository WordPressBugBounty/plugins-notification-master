#: includes/abilities/class-notification-abilities.php:619
#, php-format
msgid "The setting \"%1$s\" cannot be edited on a %2$s connection. Editable keys: %3$s."
msgstr ""

#: includes/abilities/class-notification-abilities.php:755
msgid "Create notification from template"
